generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Account {
  id                    String    @id @default(cuid())
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
  @@map("accounts")
}

model AuditLog {
  id          String      @id @default(cuid())
  userId      String
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  user        User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace?  @relation(fields: [workspaceId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@index([workspaceId])
  @@map("audit_logs")
}

model BillingCustomer {
  id               String      @id @default(cuid())
  userId           String      @unique
  workspaceId      String?     @unique
  stripeCustomerId String      @unique
  billingEmail     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt
  user             User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace        Workspace?  @relation(fields: [workspaceId], references: [id])

  @@index([stripeCustomerId])
  @@map("billing_customers")
}

model BrandColor {
  id             String       @id @default(cuid())
  brandProfileId String
  name           String
  hexValue       String
  role           String       @default("additional")
  createdAt      DateTime     @default(now())
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("brand_colors")
}

model BrandFont {
  id             String       @id @default(cuid())
  brandProfileId String
  name           String
  family         String
  role           String       @default("body")
  weight         Int          @default(400)
  url            String?
  createdAt      DateTime     @default(now())
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("brand_fonts")
}

model BrandLogo {
  id             String       @id @default(cuid())
  brandProfileId String
  fileUrl        String
  storageKey     String
  logoType       String       @default("primary")
  backgroundType String       @default("any")
  width          Int?
  height         Int?
  createdAt      DateTime     @default(now())
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("brand_logos")
}

model BrandProfile {
  id                String         @id @default(cuid())
  userId            String         @unique
  name              String
  description       String?
  headingFont       String?
  bodyFont          String?
  buttonRadius      Int            @default(8)
  borderRadius      Int            @default(8)
  spacingPreference String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  colors            BrandColor[]
  fonts             BrandFont[]
  logos             BrandLogo[]
  user              User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  rules             BrandRule[]
  gradients         BrandGradient[]
  scans             Scan[]

  @@index([userId])
  @@map("brand_profiles")
}

model BrandRule {
  id             String       @id @default(cuid())
  brandProfileId String
  category       String
  name           String
  value          String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  brandProfile   BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("brand_rules")
}

model BrandGradient {
  id              String       @id @default(cuid())
  brandProfileId  String
  name            String
  role            String       @default("additional")
  gradientType    String       @default("linear")
  repeating       Boolean      @default(false)
  originalValue   String
  normalizedValue String
  angle           Float?
  shape           String?
  position        String?
  stops           Json
  usageCount      Int          @default(0)
  pageCount       Int          @default(0)
  sourceType      String       @default("detected")
  cssVariableName String?
  confidence      Float        @default(0.8)
  isApproved      Boolean      @default(false)
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  brandProfile    BrandProfile @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
  @@map("brand_gradients")
}

model Invitation {
  id          String     @id @default(cuid())
  workspaceId String
  email       String
  role        String     @default("member")
  token       String     @unique
  status      String     @default("pending")
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  invitedBy   User       @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([workspaceId])
  @@map("invitations")
}

model Membership {
  id          String     @id @default(cuid())
  userId      String
  workspaceId String
  role        String     @default("member")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspace   Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
  @@map("memberships")
}

model Profile {
  id                  String   @id @default(cuid())
  authUserId          String   @unique
  displayName         String?
  avatar              String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  user                User     @relation(fields: [authUserId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model ScanIssue {
  id             String   @id @default(cuid())
  scanId         String
  category       String
  severity       String
  title          String
  description    String
  recommendation String?
  metadataJson   Json?
  createdAt      DateTime @default(now())
  scan           Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
  @@map("scan_issues")
}

model ScanPage {
  id                   String   @id @default(cuid())
  scanId               String
  url                  String
  pageTitle            String?
  desktopScreenshotUrl String?
  mobileScreenshotUrl  String?
  status               String   @default("pending")
  createdAt            DateTime @default(now())
  scan                 Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("scan_pages")
}

model ScanScore {
  id        String   @id @default(cuid())
  scanId    String
  category  String
  score     Float
  weight    Float
  createdAt DateTime @default(now())
  scan      Scan     @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@map("scan_scores")
}

model Scan {
  id              String          @id @default(cuid())
  userId          String
  brandProfileId  String
  scanType        String
  status          String          @default("pending")
  sourceUrl       String?
  sourceFileUrl   String?
  platform        String?
  overallScore    Float?
  scoringVersion  String          @default("1.0")
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  progress        Int             @default(0)
  currentStage    String?
  pagesDiscovered Int             @default(0)
  pagesAnalyzed   Int             @default(0)
  warnings        Json            @default("[]")
  issues          ScanIssue[]
  pages           ScanPage[]
  scores          ScanScore[]
  brandProfile    BrandProfile    @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  usageRecords    UsageRecord[]

  @@index([brandProfileId])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
  @@map("scans")
}

model Session {
  id        String   @id @default(cuid())
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model Subscription {
  id                   String     @id @default(cuid())
  workspaceId          String
  stripeSubscriptionId String     @unique
  stripeCustomerId     String
  stripePriceId        String
  planKey              String
  status               String
  billingInterval      String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
  workspace            Workspace  @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([workspaceId])
  @@map("subscriptions")
}

model UsageRecord {
  id                 String   @id @default(cuid())
  userId             String
  scanId             String?
  usageType          String
  quantity           Int      @default(1)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  idempotencyKey     String   @unique
  createdAt          DateTime @default(now())
  scan               Scan?    @relation(fields: [scanId], references: [id])
  user               User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([billingPeriodStart])
  @@index([usageType])
  @@index([userId])
  @@map("usage_records")
}

model User {
  id                String             @id @default(cuid())
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  accounts          Account[]
  auditLogs         AuditLog[]
  billingCustomer   BillingCustomer?
  brandProfile      BrandProfile?
  invitations       Invitation[]
  memberships       Membership[]
  profile           Profile?
  scans             Scan[]
  sessions          Session[]
  usageRecords      UsageRecord[]

  @@map("users")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@unique([identifier, value])
  @@map("verifications")
}

model WebhookEvent {
  id              String    @id @default(cuid())
  provider        String
  externalEventId String
  eventType       String
  status          String    @default("pending")
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, externalEventId])
  @@index([status])
  @@map("webhook_events")
}

model Workspace {
  id                String             @id @default(cuid())
  name              String
  slug              String             @unique
  ownerId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  auditLogs         AuditLog[]
  billingCustomer   BillingCustomer?
  invitations       Invitation[]
  memberships       Membership[]
  subscriptions     Subscription[]

  @@index([ownerId])
  @@index([slug])
  @@map("workspaces")
}
