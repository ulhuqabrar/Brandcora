generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model accounts {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime
  users                 users     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([accountId, providerId])
}

model audit_logs {
  id          String      @id
  userId      String
  workspaceId String?
  action      String
  entityType  String
  entityId    String?
  metadata    Json?
  createdAt   DateTime    @default(now())
  users       users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces  workspaces? @relation(fields: [workspaceId], references: [id])

  @@index([action])
  @@index([createdAt])
  @@index([userId])
  @@index([workspaceId])
}

model billing_customers {
  id               String      @id
  userId           String      @unique
  workspaceId      String?     @unique
  stripeCustomerId String      @unique
  billingEmail     String?
  createdAt        DateTime    @default(now())
  updatedAt        DateTime
  users            users       @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces       workspaces? @relation(fields: [workspaceId], references: [id])

  @@index([stripeCustomerId])
}

model brand_colors {
  id             String         @id
  brandProfileId String
  name           String
  hexValue       String
  role           String         @default("additional")
  createdAt      DateTime       @default(now())
  brand_profiles brand_profiles @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model brand_fonts {
  id             String         @id
  brandProfileId String
  name           String
  family         String
  role           String         @default("body")
  weight         Int            @default(400)
  url            String?
  createdAt      DateTime       @default(now())
  brand_profiles brand_profiles @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model brand_logos {
  id             String         @id
  brandProfileId String
  fileUrl        String
  storageKey     String
  logoType       String         @default("primary")
  backgroundType String         @default("any")
  width          Int?
  height         Int?
  createdAt      DateTime       @default(now())
  brand_profiles brand_profiles @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model brand_profiles {
  id                String         @id
  userId            String         @unique
  name              String
  description       String?
  headingFont       String?
  bodyFont          String?
  buttonRadius      Int            @default(8)
  borderRadius      Int            @default(8)
  spacingPreference String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime
  brand_colors      brand_colors[]
  brand_fonts       brand_fonts[]
  brand_logos       brand_logos[]
  users             users          @relation(fields: [userId], references: [id], onDelete: Cascade)
  brand_rules       brand_rules[]
  brand_gradients   brand_gradients[]
  scans             scans[]

  @@index([userId])
}

model brand_rules {
  id             String         @id
  brandProfileId String
  category       String
  name           String
  value          String
  createdAt      DateTime       @default(now())
  updatedAt      DateTime
  brand_profiles brand_profiles @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model brand_gradients {
  id               String   @id
  brandProfileId   String
  name             String
  role             String   @default("additional")
  gradientType     String   @default("linear")
  repeating        Boolean  @default(false)
  originalValue    String
  normalizedValue  String
  angle            Float?
  shape            String?
  position         String?
  stops            Json
  usageCount       Int      @default(0)
  pageCount        Int      @default(0)
  sourceType       String   @default("detected")
  cssVariableName  String?
  confidence       Float    @default(0.8)
  isApproved       Boolean  @default(false)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  brand_profiles   brand_profiles @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)

  @@index([brandProfileId])
}

model invitations {
  id          String     @id
  workspaceId String
  email       String
  role        String     @default("member")
  token       String     @unique
  status      String     @default("pending")
  invitedById String
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  users       users      @relation(fields: [invitedById], references: [id], onDelete: Cascade)
  workspaces  workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([email])
  @@index([token])
  @@index([workspaceId])
}

model memberships {
  id          String     @id
  userId      String
  workspaceId String
  role        String     @default("member")
  createdAt   DateTime   @default(now())
  updatedAt   DateTime
  users       users      @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaces  workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@unique([userId, workspaceId])
  @@index([workspaceId])
}

model profiles {
  id                  String   @id
  authUserId          String   @unique
  displayName         String?
  avatar              String?
  onboardingCompleted Boolean  @default(false)
  createdAt           DateTime @default(now())
  updatedAt           DateTime
  users               users    @relation(fields: [authUserId], references: [id], onDelete: Cascade)
}

model scan_issues {
  id             String   @id
  scanId         String
  category       String
  severity       String
  title          String
  description    String
  recommendation String?
  metadataJson   Json?
  createdAt      DateTime @default(now())
  scans          scans    @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
  @@index([severity])
}

model scan_pages {
  id                   String   @id
  scanId               String
  url                  String
  pageTitle            String?
  desktopScreenshotUrl String?
  mobileScreenshotUrl  String?
  status               String   @default("pending")
  createdAt            DateTime @default(now())
  scans                scans    @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model scan_scores {
  id        String   @id
  scanId    String
  category  String
  score     Float
  weight    Float
  createdAt DateTime @default(now())
  scans     scans    @relation(fields: [scanId], references: [id], onDelete: Cascade)

  @@index([scanId])
}

model scans {
  id              String          @id
  userId          String
  brandProfileId  String
  scanType        String
  status          String          @default("pending")
  sourceUrl       String?
  sourceFileUrl   String?
  platform        String?
  overallScore    Float?
  scoringVersion  String          @default("1.0")
  startedAt       DateTime?
  completedAt     DateTime?
  failedAt        DateTime?
  errorCode       String?
  errorMessage    String?
  createdAt       DateTime        @default(now())
  progress        Int             @default(0)
  currentStage    String?
  pagesDiscovered Int             @default(0)
  pagesAnalyzed   Int             @default(0)
  warnings        Json            @default("[]")
  scan_issues     scan_issues[]
  scan_pages      scan_pages[]
  scan_scores     scan_scores[]
  brand_profiles  brand_profiles  @relation(fields: [brandProfileId], references: [id], onDelete: Cascade)
  users           users           @relation(fields: [userId], references: [id], onDelete: Cascade)
  usage_records   usage_records[]

  @@index([brandProfileId])
  @@index([createdAt])
  @@index([status])
  @@index([userId])
}

model sessions {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  ipAddress String?
  userAgent String?
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime
  users     users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model subscriptions {
  id                   String     @id
  workspaceId          String
  stripeSubscriptionId String     @unique
  stripeCustomerId     String
  stripePriceId        String
  planKey              String
  status               String
  billingInterval      String
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean    @default(false)
  createdAt            DateTime   @default(now())
  updatedAt            DateTime
  workspaces           workspaces @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  @@index([stripeCustomerId])
  @@index([stripeSubscriptionId])
  @@index([workspaceId])
}

model usage_records {
  id                 String   @id
  userId             String
  scanId             String?
  usageType          String
  quantity           Int      @default(1)
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime
  idempotencyKey     String   @unique
  createdAt          DateTime @default(now())
  scans              scans?   @relation(fields: [scanId], references: [id])
  users              users    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([billingPeriodStart])
  @@index([usageType])
  @@index([userId])
}

model users {
  id                String             @id
  name              String
  email             String             @unique
  emailVerified     Boolean            @default(false)
  image             String?
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  accounts          accounts[]
  audit_logs        audit_logs[]
  billing_customers billing_customers?
  brand_profiles    brand_profiles?
  invitations       invitations[]
  memberships       memberships[]
  profiles          profiles?
  scans             scans[]
  sessions          sessions[]
  usage_records     usage_records[]
}

model verifications {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime

  @@unique([identifier, value])
}

model webhook_events {
  id              String    @id
  provider        String
  externalEventId String
  eventType       String
  status          String    @default("pending")
  failureReason   String?
  processedAt     DateTime?
  createdAt       DateTime  @default(now())

  @@unique([provider, externalEventId])
  @@index([status])
}

model workspaces {
  id                String             @id
  name              String
  slug              String             @unique
  ownerId           String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime
  audit_logs        audit_logs[]
  billing_customers billing_customers?
  invitations       invitations[]
  memberships       memberships[]
  subscriptions     subscriptions[]

  @@index([ownerId])
  @@index([slug])
}
